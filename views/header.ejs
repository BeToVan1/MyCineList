<header><div class="shell mast">
  <a href="/" class="brand" aria-label="MyCineList home"><span class="ticket" aria-hidden="true"><i></i><i></i><i></i></span><%- include('wordmark') %></a>
  <% const page = typeof currentPage === 'undefined' ? '' : currentPage; %>
  <nav aria-label="Main navigation">
    <a href="<%= signedIn ? '/loggedin' : '/' %>" id="nav-discover" <% if (page === 'discover') { %>aria-current="page"<% } %>>Discover</a>
    <a href="/mylist" id="nav-list" <% if (page === 'list') { %>aria-current="page"<% } %>>My list <span id="list-count"><%= count %></span></a>
    <a href="/watchlist" id="nav-watchlist" <% if (page === 'watchlist') { %>aria-current="page"<% } %>>Watchlist</a>
  </nav>
  <form class="search" action="/" role="search"><span data-icon="search"></span><input id="query" name="q" type="search" aria-label="Search films" placeholder="Search films…"><kbd aria-hidden="true">/</kbd></form>
  <a class="account-link" href="<%= signedIn ? '/logout' : '/login' %>"><%= signedIn ? 'Sign out' : 'Sign in' %></a>
</div></header>
