{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node scripts/build-discover.js",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:page(login|register|loggedin|logout|moviepage|mylist|mylist-title-inc|mylist-title-dec|mylist-score-inc|mylist-score-dec)",
      "destination": "https://mycinelist.onrender.com/:page",
      "permanent": false
    },
    {
      "source": "/:list(list|list-title-inc|list-title-dec|list-score-inc|list-score-dec)/:id",
      "destination": "https://mycinelist.onrender.com/:list/:id",
      "permanent": false
    },
    {
      "source": "/auth/:path*",
      "destination": "https://mycinelist.onrender.com/auth/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/catalog",
      "destination": "https://mycinelist.onrender.com/api/catalog"
    },
    {
      "source": "/api/films/:id",
      "destination": "https://mycinelist.onrender.com/api/films/:id"
    }
  ]
}
