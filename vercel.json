{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node scripts/build-discover.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:page(login|register|loggedin|logout|moviepage|watchlist|mylist|mylist-title-inc|mylist-title-dec|mylist-score-inc|mylist-score-dec|save-movie-score|remove)",
      "destination": "/api/backend"
    },
    {
      "source": "/:list(list|list-title-inc|list-title-dec|list-score-inc|list-score-dec)/:id",
      "destination": "/api/backend"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/backend"
    },
    {
      "source": "/api/:endpoint(catalog|session|user-movie-data)",
      "destination": "/api/backend"
    },
    {
      "source": "/api/:collection(films|watchlist)/:id",
      "destination": "/api/backend"
    }
  ],
  "functions": {
    "api/backend.js": {
      "includeFiles": "views/**"
    }
  }
}
